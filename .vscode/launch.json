// Start a second VS Code window that loads the extension from this folder, so
// that a change can be tried without a package. Open a folder whose comments
// carry Markdown links in that window. A reload of that window loads a change.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"]
    }
  ]
}
